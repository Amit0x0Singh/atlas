generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model RmMaster {
  itemCode     String   @id @map("item_code")
  itemName     String   @unique @map("item_name")
  uom          String
  trackingType String   @default("PACK") @map("tracking_type") // PACK | BULK
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  @@map("rm_master")
}

// ─── BULK TRACKING ───────────────────────────────────────────────────────────

model BulkLocation {
  locationId   String         @id @map("location_id")   // e.g. LOC-001, LOC-SHELF-A2
  locationName String         @map("location_name")
  itemCode     String         @map("item_code")
  itemName     String         @map("item_name")
  uom          String         @default("KG")
  createdAt    DateTime       @default(now()) @map("created_at")
  lotEntries   BulkLotEntry[]
  @@map("bulk_location")
}

model BulkLotEntry {
  id           String       @id @default(cuid())
  locationId   String       @map("location_id")
  itemCode     String       @map("item_code")
  itemName     String       @map("item_name")
  lotNo        String       @map("lot_no")           // e.g. BULK-151464-2026-001
  supplier     String?
  invoiceNo    String?      @map("invoice_no")
  receivedDate DateTime?    @map("received_date")
  receivedQty  Float        @map("received_qty")
  remainingQty Float        @map("remaining_qty")
  uom          String       @default("KG")
  status       String       @default("ACTIVE")       // ACTIVE | EXHAUSTED
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  location     BulkLocation @relation(fields: [locationId], references: [locationId])
  @@map("bulk_lot_entry")
}

model BulkLotSequence {
  itemCode String @map("item_code")
  year     Int
  seq      Int    @default(0)
  @@id([itemCode, year])
  @@map("bulk_lot_sequence")
}

model ProductMaster {
  productCode String   @id @map("product_code")
  productName String   @unique @map("product_name")
  plant       String   @default("")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  @@map("product_master")
}

model EquipmentMaster {
  equipId       String   @id @default(cuid()) @map("equip_id")
  equipName     String   @unique @map("equip_name")
  workingVolume Float?   @map("working_volume")
  operation     String   @default("") @map("operation")
  plant         String   @default("")
  createdAt     DateTime @default(now()) @map("created_at")
  @@map("equipment_master")
}

model LotSequence {
  itemCode String @map("item_code")
  year     Int
  seq      Int    @default(0)
  @@id([itemCode, year])
  @@map("lot_sequence")
}

model PrintMaster {
  packId       String    @id @map("pack_id")
  itemCode     String    @map("item_code")
  itemName     String    @map("item_name")
  lotNo        String    @map("lot_no")
  bagNo        Int       @map("bag_no")
  packQty      Float     @map("pack_qty")
  uom          String
  supplier     String?
  invoiceNo    String?   @map("invoice_no")
  receivedDate DateTime? @map("received_date")
  status       String    @default("AWAITING_INWARD")
  createdAt    DateTime  @default(now()) @map("created_at")
  @@unique([itemCode, lotNo, bagNo])
  @@map("print_master")
}

model InwardSession {
  sessionId      String   @id @default(cuid()) @map("session_id")
  itemCode       String   @map("item_code")
  lotNo          String   @map("lot_no")
  warehouse      String
  expectedBags   Int      @map("expected_bags")
  scannedPackIds String[] @map("scanned_pack_ids")
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  @@map("inward_session")
}

model Inward {
  id         String   @id @default(cuid())
  packId     String   @map("pack_id")
  itemCode   String   @map("item_code")
  itemName   String   @map("item_name")
  lotNo      String   @map("lot_no")
  bagNo      Int      @map("bag_no")
  qty        Float
  inwardTime DateTime @default(now()) @map("inward_time")
  warehouse  String
  @@map("inward")
}

model PackBalance {
  packId       String @id @map("pack_id")
  itemCode     String @map("item_code")
  totalQty     Float  @map("total_qty")
  remainingQty Float  @map("remaining_qty")
  @@map("pack_balance")
}

model ContainerMaster {
  containerId String @id @map("container_id")
  itemCode    String @unique @map("item_code")
  itemName    String @map("item_name")
  capacity    Float
  currentQty  Float  @default(0) @map("current_qty")
  uom         String
  @@map("container_master")
}

model RecipeDb {
  id          String  @id @default(cuid())
  productCode String  @map("product_code")
  productName String  @map("product_name")
  rmCode      String  @map("rm_code")
  rmName      String  @map("rm_name")
  qtyPerUnit  Float   @map("qty_per_unit")
  uom         String
  roleType    String  @default("INGREDIENT") @map("role_type") // INGREDIENT | CARRIER | BASE
  @@unique([productCode, rmCode])
  @@map("recipe_db")
}

model IndentMaster {
  indentId        String        @id @default(cuid()) @map("indent_id")
  productCode     String        @map("product_code")
  productName     String        @map("product_name")
  batchSize       Float         @map("batch_size")
  batchNo         String        @map("batch_no")
  diNo            String        @map("di_no")
  plant           String        @default("")
  equipment       String        @default("")
  cycleBatchSize  Float?        @map("cycle_batch_size")   // per-cycle qty when multi-cycle
  cycleNo         Int?          @map("cycle_no")            // which cycle this indent is (1-based)
  totalCycles     Int?          @map("total_cycles")        // total cycles for this DI
  status          String        @default("OPEN")
  poSentAt        DateTime?     @map("po_sent_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  details         IndentDetails[]
  productionBatches ProductionBatch[]
  @@map("indent_master")
}

model IndentDetails {
  id          String       @id @default(cuid())
  indentId    String       @map("indent_id")
  rmCode      String       @map("rm_code")
  rmName      String       @map("rm_name")
  requiredQty Float        @map("required_qty")
  issuedQty   Float        @default(0) @map("issued_qty")
  balanceQty  Float        @map("balance_qty")
  indent      IndentMaster @relation(fields: [indentId], references: [indentId])
  @@map("indent_details")
}

model Outward {
  id         String   @id @default(cuid())
  indentId   String?  @map("indent_id")
  sourceId   String   @map("source_id")
  sourceType String   @map("source_type")
  rmCode     String   @map("rm_code")
  qtyIssued  Float    @map("qty_issued")
  remarks    String?
  timestamp  DateTime @default(now())
  @@map("outward")
}

model StockLedger {
  id              String   @id @default(cuid())
  itemCode        String   @map("item_code")
  sourceId        String   @map("source_id")
  transactionType String   @map("transaction_type")
  inQty           Float    @default(0) @map("in_qty")
  outQty          Float    @default(0) @map("out_qty")
  balance         Float
  reference       String?
  timestamp       DateTime @default(now())
  @@map("stock_ledger")
}

model SfgMaster {
  sfgId         String   @id @default(cuid()) @map("sfg_id")
  indentId      String   @map("indent_id")
  productCode   String   @map("product_code")
  productName   String   @map("product_name")
  targetQty     Float    @map("target_qty")
  formulatedQty Float    @default(0) @map("formulated_qty")
  sfgQty        Float    @default(0) @map("sfg_qty")
  packedQty     Float    @default(0) @map("packed_qty")
  status        String   @default("OPEN")
  remarks       String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  @@map("sfg_master")
}

// ─── PRODUCTION MASTER ────────────────────────────────────────────────────────

model ProductionBatch {
  id              String    @id @default(cuid())
  indentId        String    @map("indent_id")
  productCode     String    @map("product_code")
  productName     String    @map("product_name")
  diNo            String    @map("di_no")
  batchCode       String    @map("batch_code")
  orderQty        Float     @map("order_qty")
  category        String    @default("POWDER")
  currentStage    String    @default("BIOMASS") @map("current_stage")
  status          String    @default("DRAFT")
  temperature     Float?
  humidity        Float?
  cfuTarget       String?   @map("cfu_target")
  biomassFlag     Boolean   @default(false) @map("biomass_flag")
  technicalFlag   Boolean   @default(false) @map("technical_flag")
  formulationFlag Boolean   @default(false) @map("formulation_flag")
  sievingFlag     Boolean   @default(false) @map("sieving_flag")
  packingFlag     Boolean   @default(false) @map("packing_flag")
  qcFlag          Boolean   @default(false) @map("qc_flag")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  indent          IndentMaster @relation(fields: [indentId], references: [indentId])
  biomassInputs   BiomassInput[]
  technicalDetail TechnicalDetail?
  formulationCycles FormulationCycle[]
  unloadingLog    UnloadingLog?
  sievingLog      SievingLog?
  packingLog      PackingLog?
  qcSample        QcSample?
  inventoryHandover InventoryHandover?
  @@map("production_batch")
}

model BiomassInput {
  id            String   @id @default(cuid())
  batchId       String   @map("batch_id")
  cultureName   String   @default("") @map("culture_name")
  batchNo       String   @default("") @map("batch_no")
  doi           String   @default("") @map("doi")
  cfuPerGram    Float?   @map("cfu_per_gram")
  biomassQty    Float?   @map("biomass_qty")
  moisture      Float?
  form          String   @default("") @map("form")
  receivedFrom  String   @default("") @map("received_from")
  receivedDate  String   @default("") @map("received_date")
  receivedTime  String   @default("") @map("received_time")
  flagged       Boolean  @default(false)
  batch         ProductionBatch @relation(fields: [batchId], references: [id])
  @@map("biomass_input")
}

model TechnicalDetail {
  id                String   @id @default(cuid())
  batchId           String   @unique @map("batch_id")
  method            String   @default("MANUAL")
  startTime         String   @default("") @map("start_time")
  endTime           String   @default("") @map("end_time")
  biomassQty        Float?   @map("biomass_qty")
  silicaQty         Float?   @map("silica_qty")
  caco3Qty          Float?   @map("caco3_qty")
  mgStearateQty     Float?   @map("mg_stearate_qty")
  smpQty            Float?   @map("smp_qty")
  totalTechnicalQty Float?   @map("total_technical_qty")
  qtyAfterSieving   Float?   @map("qty_after_sieving")
  wastage           Float?
  flagged           Boolean  @default(false)
  batch             ProductionBatch @relation(fields: [batchId], references: [id])
  @@map("technical_detail")
}

model FormulationCycle {
  id              String    @id @default(cuid())
  batchId         String    @map("batch_id")
  cycleNo         Int       @map("cycle_no")
  formulationDate String    @default("") @map("formulation_date")
  startTime       String    @default("") @map("start_time")
  endTime         String    @default("") @map("end_time")
  noOfWorkers     Int?      @map("no_of_workers")
  sfgUsed         Boolean   @default(false) @map("sfg_used")
  sfgId           String?   @map("sfg_id")
  sfgDiNo         String?   @map("sfg_di_no")
  sfgQtyUsed      Float?    @map("sfg_qty_used")
  carrierType     String?   @map("carrier_type")
  inchargeName    String?   @map("incharge_name")
  flagged         Boolean   @default(false)
  batch           ProductionBatch @relation(fields: [batchId], references: [id])
  @@map("formulation_cycle")
}

model UnloadingLog {
  id           String   @id @default(cuid())
  batchId      String   @unique @map("batch_id")
  startTime    String   @default("") @map("start_time")
  endTime      String   @default("") @map("end_time")
  weightAfter  Float?   @map("weight_after")
  noOfWorkers  Int?     @map("no_of_workers")
  inchargeName String?  @map("incharge_name")
  flagged      Boolean  @default(false)
  batch        ProductionBatch @relation(fields: [batchId], references: [id])
  @@map("unloading_log")
}

model SievingLog {
  id           String   @id @default(cuid())
  batchId      String   @unique @map("batch_id")
  sievingDone  Boolean  @default(false) @map("sieving_done")
  meshSize     String?  @map("mesh_size")
  startTime    String   @default("") @map("start_time")
  endTime      String   @default("") @map("end_time")
  noOfWorkers  Int?     @map("no_of_workers")
  inchargeName String?  @map("incharge_name")
  flagged      Boolean  @default(false)
  batch        ProductionBatch @relation(fields: [batchId], references: [id])
  @@map("sieving_log")
}

model PackingLog {
  id                 String   @id @default(cuid())
  batchId            String   @unique @map("batch_id")
  packingType        String?  @map("packing_type")
  weightPerUnit      Float?   @map("weight_per_unit")
  totalUnitsPacked   Int?     @map("total_units_packed")
  totalQtyPacked     Float?   @map("total_qty_packed")
  unitsPerBag        Int?     @map("units_per_bag")
  totalOuterPackages Int?     @map("total_outer_packages")
  packingStart       String   @default("") @map("packing_start")
  packingEnd         String   @default("") @map("packing_end")
  labelingStart      String   @default("") @map("labeling_start")
  labelingEnd        String   @default("") @map("labeling_end")
  strappingStart     String   @default("") @map("strapping_start")
  strappingEnd       String   @default("") @map("strapping_end")
  stretchWrapping    Boolean  @default(false) @map("stretch_wrapping")
  noOfCartons        Int?     @map("no_of_cartons")
  noOfWorkers        Int?     @map("no_of_workers")
  inchargeName       String?  @map("incharge_name")
  flagged            Boolean  @default(false)
  batch              ProductionBatch @relation(fields: [batchId], references: [id])
  @@map("packing_log")
}

model QcSample {
  id               String    @id @default(cuid())
  batchId          String    @unique @map("batch_id")
  sampleCollected  Boolean   @default(false) @map("sample_collected")
  sampleId         String?   @map("sample_id")
  collectedAtStage String?   @map("collected_at_stage")
  submittedOn      String?   @map("submitted_on")
  rxAttached       Boolean   @default(false) @map("rx_attached")
  flagged          Boolean   @default(false)
  batch            ProductionBatch @relation(fields: [batchId], references: [id])
  @@map("qc_sample")
}

model InventoryHandover {
  id                String    @id @default(cuid())
  batchId           String    @unique @map("batch_id")
  sentToInventoryOn String?   @map("sent_to_inventory_on")
  handedOverTo      String?   @map("handed_over_to")
  leftoverQtyAt     String?   @map("leftover_qty_at")
  sfgUpdated        Boolean   @default(false) @map("sfg_updated")
  batch             ProductionBatch @relation(fields: [batchId], references: [id])
  @@map("inventory_handover")
}

// ─── EMPLOYEE & ACCESS CONTROL ───────────────────────────────────────────────

model CompanyMaster {
  id          String   @id @default(cuid())
  code        String   @unique  // DVS, SOM, AL-IPL, AL-PTE
  name        String
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  @@map("company_master")
}

model EmployeeMaster {
  id          String   @id @default(cuid())
  empCode     String   @unique @map("emp_code")
  name        String
  email       String?  @unique
  phone       String?
  role        String   // ADMIN | SALES | PRODUCTION | QC | DISPATCH | PLANNING | ACCOUNTS
  section     String?  // NANO | BOTANICAL | LIQUID | POWDER | GRANULES (for PRODUCTION role)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  @@map("employee_master")
}

model RolePermission {
  id        String @id @default(cuid())
  role      String
  pagePath  String @map("page_path")
  pageLabel String @map("page_label")
  @@unique([role, pagePath])
  @@map("role_permission")
}

// ─── SALES ORDER ─────────────────────────────────────────────────────────────

model SalesOrder {
  id                    String           @id @default(cuid())
  soId                  String           @unique @map("so_id")   // auto: SO-2026-0001
  company               String           // DVS | SOM | AL-IPL | AL-PTE
  diNo                  String           @map("di_no")
  customerName          String           @map("customer_name")
  orderType             String           @map("order_type")      // DOMESTIC | EXPORT | SAMPLE
  orderReceivedDate     DateTime         @map("order_received_date")
  priority              String           @default("MODERATE")    // URGENT | VERY_URGENT | MODERATE
  estimatedDispatchDate DateTime         @map("estimated_dispatch_date")
  invoiceNo             String?          @map("invoice_no")
  invoiceDate           DateTime?        @map("invoice_date")
  transportName         String?          @map("transport_name")
  salesStaff            String?          @map("sales_staff")
  dispatchedBy          String?          @map("dispatched_by")
  remarks               String?
  createdAt             DateTime         @default(now()) @map("created_at")
  updatedAt             DateTime         @updatedAt @map("updated_at")
  items                 SalesOrderItem[]
  @@map("sales_order")
}

model SalesOrderItem {
  id                  String     @id @default(cuid())
  salesOrderId        String     @map("sales_order_id")
  salesOrder          SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  lineNo              Int        @map("line_no")                 // 1, 2, 3…
  customerProductName String     @map("customer_product_name")
  inhouseProductName  String     @map("inhouse_product_name")
  inhouseProductCode  String?    @map("inhouse_product_code")
  activeSpecs         String?    @map("active_specs")
  activeIngredient    String?    @map("active_ingredient")
  carrier             String?
  batchNo             String?    @map("batch_no")
  sectionName         String?    @map("section_name")            // NANO|BOTANICAL|LIQUID|POWDER|GRANULES
  totalQty            Float      @map("total_qty")
  totalUom            String     @default("KG") @map("total_uom")
  unitQty             Float?     @map("unit_qty")
  unitUom             String?    @map("unit_uom")
  unitPackType        String?    @map("unit_pack_type")           // Primary packing: e.g. Pouch, Bottle, Sachet
  packingType         String?    @map("packing_type")             // Secondary packing: Cartons | OMB30 | OMB50 | etc.
  totalCS             Int?       @map("total_cs")                 // Total no. of final packs
  labelType           String?    @map("label_type")               // CUSTOMER | PACKING_SLIP | COMPUTER_LABELS
  mrp                 Float?
  mfgDate             DateTime?  @map("mfg_date")
  expDate             DateTime?  @map("exp_date")
  status              String     @default("PENDING")
  // PENDING | PLANNED | UNDER_PRODUCTION | PACKED | IN_INVENTORY | READY_TO_DISPATCH | DISPATCHED
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")
  @@map("sales_order_item")
}

model SoSequence {
  year  Int  @id
  seq   Int  @default(0)
  @@map("so_sequence")
}

// ─── PRODUCTION PLANNING ENGINE ───────────────────────────────────────────────

model ProductionPlan {
  id               String   @id @default(cuid())
  planId           String   @unique @map("plan_id")       // PP-2026-0001
  salesOrderId     String?  @map("sales_order_id")
  salesOrderItemId String?  @map("sales_order_item_id")
  diNo             String   @map("di_no")
  customerName     String?  @map("customer_name")
  sectionType      String   @map("section_type")          // NANO|BOTANICAL|LIQUID|POWDER|GRANULES
  plannedDate      DateTime @map("planned_date")
  shift            String?                                 // A|G|B|C
  batchIncharge    String?  @map("batch_incharge")
  noOfCycles       Int?     @map("no_of_cycles")
  cycleBatchSize   Float?   @map("cycle_batch_size")
  equipment        String?
  location         String?
  productCode      String?  @map("product_code")
  productName      String   @map("product_name")
  batchCode        String?  @map("batch_code")
  totalQty         Float    @map("total_qty")
  uom              String   @default("KG")
  carrier          String?
  specs            String?
  process          String?
  stageInfo        String?  @map("stage_info")            // BOTANICAL: days/hours
  // Packing
  unitPackQty      Float?   @map("unit_pack_qty")
  noOfUnits        Int?     @map("no_of_units")
  pp1              String?
  pp2              String?
  sp1              String?
  noOfSp           Int?     @map("no_of_sp")
  labels           String?
  packingSpec      String?  @map("packing_spec")
  perDayCompletion Int?     @map("per_day_completion")
  femaleWorkers    Int?     @map("female_workers")
  maleWorkers      Int?     @map("male_workers")
  // Status & checks
  status           String   @default("DRAFT")             // DRAFT|REVIEWED|IN_PROGRESS|COMPLETED|CANCELLED
  rmCheckStatus    String?  @map("rm_check_status")       // GREEN|AMBER|RED
  eqpCheckStatus   String?  @map("eqp_check_status")      // AVAILABLE|BUSY|UNKNOWN
  rmCheckDetails   Json?    @map("rm_check_details")      // [{rmCode, required, available, status}]
  autoGenerated    Boolean  @default(false) @map("auto_generated")
  remarks          String?
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  @@map("production_plan")
}

model PlanSequence {
  year Int @id
  seq  Int @default(0)
  @@map("plan_sequence")
}

model PlannerLog {
  id        String   @id @default(cuid())
  runAt     DateTime @default(now()) @map("run_at")
  trigger   String                                         // MANUAL|SCHEDULED
  plansCreated Int   @default(0) @map("plans_created")
  ordersProcessed Int @default(0) @map("orders_processed")
  errors    String?
  @@map("planner_log")
}

// ─── GOOGLE SHEET SYNC LOG ────────────────────────────────────────────────────
model SheetSyncLog {
  id         String   @id @default(cuid())
  trigger    String   @default("WEBHOOK")   // WEBHOOK | MANUAL | SCHEDULED
  rowsIn     Int      @default(0) @map("rows_in")
  imported   Int      @default(0)
  skipped    Int      @default(0)
  errors     Json?
  createdAt  DateTime @default(now()) @map("created_at")
  @@map("sheet_sync_log")
}

// ─── CUSTOMER PROFILE (memory layer — auto-fill on Sales Orders) ─────────────
model CustomerProfile {
  id           String   @id @default(cuid())
  customerName String   @unique @map("customer_name")
  company      String   @default("")
  orderType    String   @default("DOMESTIC") @map("order_type")
  orderCount   Int      @default(1) @map("order_count")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")
  @@map("customer_profile")
}

// ─── CUSTOMER-PRODUCT PROFILE (deep memory — auto-fill all SO line fields) ───
// Key: (customerName, productName) where productName = customer-facing product name
model CustomerProductProfile {
  id            String   @id @default(cuid())
  customerName  String   @map("customer_name")
  productName   String   @map("product_name")          // customer-facing product name (PRIMARY KEY)
  productCode   String?  @map("product_code")          // inhouse product code (optional, linked later)
  inhouseName   String?  @map("inhouse_name")          // inhouse product name (optional)

  // Specs & process
  activeSpecs   String?  @map("active_specs")
  carrier       String?
  sectionName   String?  @map("section_name")

  // Packing — unit level
  unitQty       Float?   @map("unit_qty")              // e.g. 1.0 (from "1KG", "0.5L")
  unitUom       String?  @map("unit_uom")              // KG / LTR / GM / ML
  unitPackType  String?  @map("unit_pack_type")        // free-text description
  primaryPack   String?  @map("primary_pack")          // LD Pouch / AL Pouch / Bottle etc.
  secondaryPack String?  @map("secondary_pack")        // B-CBB / W-CBB / Drum etc.
  unitsPerCS    Int?     @map("units_per_cs")           // how many primary packs per secondary pack
  totalUom      String?  @default("KG") @map("total_uom")

  // Label
  labelType     String?  @map("label_type")
  mrp           Float?

  // Batch memory — last batch no + inferred shelf life
  lastBatchNo   String?  @map("last_batch_no")
  shelfLifeDays Int?     @map("shelf_life_days")       // EXP minus MFG in days, learned from past

  // Confidence
  orderCount    Int      @default(1) @map("order_count")
  lastOrderedAt DateTime @default(now()) @map("last_ordered_at")

  @@unique([customerName, productName])
  @@map("customer_product_profile")
}

// ── BOM Send Requests (planner → store) ──────────────────────────────────────
// Created by planner when they want store to prepare materials.
// Formulation BOM and Packing BOM are sent as separate records.
model BomSend {
  id          String   @id @default(cuid())
  sendId      String   @unique @map("send_id")         // e.g. BOM-2605-001
  indentId    String?  @map("indent_id")               // linked indent (if RM BOM)
  planId      String   @map("plan_id")
  productCode String   @map("product_code")
  productName String   @map("product_name")
  batchNo     String   @map("batch_no")
  diNo        String   @map("di_no")
  sectionType String?  @map("section_type")
  bomType     String   @map("bom_type")                // 'FORMULATION' | 'PACKING'
  totalQty    Float    @map("total_qty")
  uom         String   @default("KG")
  status      String   @default("PENDING")             // PENDING | PICKED | ISSUED | CANCELLED
  remarks     String?
  sentBy      String?  @map("sent_by")
  sentAt      DateTime @default(now()) @map("sent_at")
  pickedAt    DateTime? @map("picked_at")
  issuedAt    DateTime? @map("issued_at")
  @@map("bom_send")
}
