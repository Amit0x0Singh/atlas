# ─────────────────────────────────────────────────────────────────────────────
# SOM ERP — Backend Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development          # development | production

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://som_user:SomErp2026!@localhost:5432/som_erp

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars

# ── Frontend ──────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173    # change to your deployed frontend URL in prod

# ─────────────────────────────────────────────────────────────────────────────
# MSG91 — WhatsApp & SMS Notifications
# Sign up at https://msg91.com and get your Auth Key from the dashboard.
# ─────────────────────────────────────────────────────────────────────────────

# Master switch — set to 'true' only in production to actually send messages.
# When 'false' (default), messages are only logged to console (mock mode).
WHATSAPP_ENABLED=false

# Your MSG91 API auth key (Dashboard → API → Auth Key)
MSG91_AUTH_KEY=

# Your MSG91 integrated WhatsApp Business number (with country code, no +)
# Example: 919876543210  (for +91 98765 43210)
MSG91_WHATSAPP_NUMBER=91XXXXXXXXXX

# ── SMS fallback ──────────────────────────────────────────────────────────────
# DLT-registered sender ID (exactly 6 uppercase letters, e.g. SOMERP)
MSG91_SENDER_ID=SOMERP

# ── WhatsApp Template (required for business-initiated alerts) ────────────────
# If your staff won't message the bot first, you MUST use pre-approved templates.
# Create a template in MSG91 → WhatsApp → Templates.  It should have one body
# variable  {{1}}  which receives the full alert text.
# Leave blank to use session/text mode (works only inside a 24h reply window).
MSG91_TEMPLATE_NAME=
MSG91_TEMPLATE_LANG=en
