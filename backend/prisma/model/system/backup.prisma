// ─── DATABASE BACKUP & RESTORE ────────────────────────────────────────────────
//
// Models in this file:
//   BackupJob   — Metadata + progress for a Full/Module/Selected-Tables backup
//   RestoreJob  — Metadata + progress for a restore, from backup history or an
//                 uploaded file
//
// Both are excluded from every backup type themselves — the backup subsystem
// never backs up or restores its own bookkeeping tables.
//
// ─────────────────────────────────────────────────────────────────────────────

model BackupJob {
  id             String    @id @default(cuid())
  name           String    @db.VarChar(200)
  type           String    @db.VarChar(20)                    // FULL | MODULE | SELECTED
  scope          String    @default("FULL") @db.VarChar(10)   // FULL (whole table) | PARTIAL (row-filtered)
  status         String    @default("RUNNING") @db.VarChar(20) // RUNNING | COMPLETED | FAILED
  tables         String[]  @default([])                       // Prisma accessor names included
  modules        String[]  @default([])                       // group keys (type = MODULE only)
  tableCount     Int       @default(0) @map("table_count")
  recordCount    Int       @default(0) @map("record_count")
  tablesTotal    Int       @default(0) @map("tables_total")
  tablesDone     Int       @default(0) @map("tables_done")
  currentTable   String?   @map("current_table")
  tableBreakdown Json?     @map("table_breakdown")             // { tableName: rowCount }
  fileSizeBytes  BigInt?   @map("file_size_bytes")
  filePath       String?   @map("file_path") @db.VarChar(500)
  fileName       String?   @map("file_name") @db.VarChar(300)
  createdBy      String?   @map("created_by") @db.VarChar(200)
  createdByName  String?   @map("created_by_name") @db.VarChar(200)
  errorMessage   String?   @map("error_message")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  completedAt    DateTime? @map("completed_at") @db.Timestamptz()

  restoreJobs RestoreJob[]
  deleteJobs  DeleteJob[]

  @@map("backup_jobs")
}

model RestoreJob {
  id             String     @id @default(cuid())
  backupJobId    String?    @map("backup_job_id")
  backupJob      BackupJob? @relation(fields: [backupJobId], references: [id], onDelete: SetNull)
  sourceType     String     @db.VarChar(20)                     // HISTORY | UPLOAD
  sourceFileName String?    @map("source_file_name") @db.VarChar(300)
  status         String     @default("PENDING") @db.VarChar(20)
  // PENDING | VALIDATING | RESTORING | COMPLETED | FAILED
  tables         String[]   @default([])
  tablesTotal    Int        @default(0) @map("tables_total")
  tablesDone     Int        @default(0) @map("tables_done")
  currentTable   String?    @map("current_table")
  recordCount    Int        @default(0) @map("record_count")
  startedBy      String?    @map("started_by") @db.VarChar(200)
  startedByName  String?    @map("started_by_name") @db.VarChar(200)
  errorMessage   String?    @map("error_message")
  startedAt      DateTime   @default(now()) @map("started_at") @db.Timestamptz()
  completedAt    DateTime?  @map("completed_at") @db.Timestamptz()

  @@map("restore_jobs")
}
