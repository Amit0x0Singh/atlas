model DeleteJob {
  id             String     @id @default(cuid())
  deleteType     String     @db.VarChar(20)
  tables         String[]   @default([])
  modules        String[]   @default([])
  recordScope    Json?      @map("record_scope")
  status         String     @default("PENDING") @db.VarChar(20)
  tablesTotal    Int        @default(0) @map("tables_total")
  tablesDone     Int        @default(0) @map("tables_done")
  currentTable   String?    @map("current_table")
  recordCount    Int        @default(0) @map("record_count")
  tableBreakdown Json?      @map("table_breakdown")
  backupJobId    String?    @map("backup_job_id")
  backupJob      BackupJob? @relation(fields: [backupJobId], references: [id], onDelete: SetNull)
  deletedBy      String?    @map("deleted_by") @db.VarChar(200)
  deletedByName  String?    @map("deleted_by_name") @db.VarChar(200)
  errorMessage   String?    @map("error_message")
  remarks        String?
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  completedAt    DateTime?  @map("completed_at") @db.Timestamptz()
  createdBy      String?    @map("created_by") @db.VarChar(200)
  updatedBy      String?    @map("updated_by") @db.VarChar(200)

  @@map("delete_jobs")
}
