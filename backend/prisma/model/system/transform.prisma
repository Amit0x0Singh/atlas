model TransformJob {
  id            String    @id @default(cuid())
  resource      String    @db.VarChar(100)
  tableName     String    @map("table_name") @db.VarChar(100)
  columns       String[]  @default([])
  transformType String    @map("transform_type") @db.VarChar(50)
  params        Json?
  targetIds     Json      @map("target_ids")
  status        String    @default("PENDING") @db.VarChar(20)
  recordsTotal  Int       @default(0) @map("records_total")
  recordsDone   Int       @default(0) @map("records_done")
  fieldsUpdated Int       @default(0) @map("fields_updated")
  skippedCount  Int       @default(0) @map("skipped_count")
  errorMessage  String?   @map("error_message")
  startedBy     String?   @map("started_by") @db.VarChar(200)
  startedByName String?   @map("started_by_name") @db.VarChar(200)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  completedAt   DateTime? @map("completed_at") @db.Timestamptz()
  createdBy     String?   @map("created_by") @db.VarChar(200)
  updatedBy     String?   @map("updated_by") @db.VarChar(200)

  @@map("transform_jobs")
}
