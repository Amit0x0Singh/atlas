model RmMaster {
  itemCode           String   @id @map("item_code")
  itemName           String   @unique @map("item_name")
  inventoryUom       String   @map("inventory_uom")
  operationalUom     String?  @map("operational_uom")
  trackingType       String   @default("PACK") @map("tracking_type")
  category           String?  @map("category")
  subCategory        String?  @map("sub_category")
  state              String?  @map("physical_state")
  density            Float?   @map("density")
  conversionRequired Boolean  @default(false) @map("conversion_required")
  lowStockLevel      Float?   @map("low_stock_level")
  highStockLevel     Float?   @map("high_stock_level")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at")
  createdBy          String?  @map("created_by") @db.VarChar(255)
  updatedBy          String?  @map("updated_by") @db.VarChar(255)

  @@map("rm_master")
}

model LotSequence {
  itemCode String @map("item_code")
  year     Int
  seq      Int    @default(0)

  @@id([itemCode, year])
  @@map("lot_sequence")
}

model PrintMaster {
  id           String   @id @default(cuid())
  gateInwardId String   @map("gate_inward_id") @db.Uuid
  itemCode     String   @map("item_code")
  itemName     String   @map("item_name")
  lotNo        String   @map("lot_no")
  packQty      Float    @map("pack_qty")
  numberOfBags Int      @map("number_of_bags")
  uom          String
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")
  createdBy    String?  @map("created_by") @db.VarChar(255)
  updatedBy    String?  @map("updated_by") @db.VarChar(255)

  gateInward GateInward   @relation(fields: [gateInwardId], references: [inwardId])
  bags       PackDetail[]

  @@unique([itemCode, lotNo])
  @@index([gateInwardId])
  @@map("print_master")
}

model PackDetail {
  packId            String    @id @map("pack_id")
  printMasterId     String    @map("print_master_id")
  itemCode          String    @map("item_code")
  bagNo             Int       @map("bag_no")
  totalQty          Float     @map("total_qty")
  remainingQty      Float     @map("remaining_qty")
  status            String    @default("AWAITING_INWARD")
  warehouse         String?
  customerBatchCode String?   @map("customer_batch_code")
  expiryDate        DateTime? @map("expiry_date")
  scannedAt         DateTime? @map("scanned_at")
  inwardedAt        DateTime? @map("inwarded_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at")
  createdBy         String?   @map("created_by") @db.VarChar(255)
  updatedBy         String?   @map("updated_by") @db.VarChar(255)

  printMaster PrintMaster @relation(fields: [printMasterId], references: [id])

  @@unique([printMasterId, bagNo])
  @@index([itemCode])
  @@index([status])
  @@index([warehouse])
  @@map("pack_detail")
}

model ContainerMaster {
  containerId String   @id @map("container_id")
  itemCode    String   @unique @map("item_code")
  itemName    String   @map("item_name")
  capacity    Float
  currentQty  Float    @default(0) @map("current_qty")
  uom         String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")
  createdBy   String?  @map("created_by") @db.VarChar(255)
  updatedBy   String?  @map("updated_by") @db.VarChar(255)

  @@map("container_master")
}

model StockLedger {
  id              String   @id @default(cuid())
  itemCode        String   @map("item_code")
  sourceId        String   @map("source_id")
  transactionType String   @map("transaction_type")
  inQty           Float    @default(0) @map("in_qty")
  outQty          Float    @default(0) @map("out_qty")
  balance         Float
  reference       String?
  timestamp       DateTime @default(now())
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")
  createdBy       String?  @map("created_by") @db.VarChar(255)
  updatedBy       String?  @map("updated_by") @db.VarChar(255)

  @@index([itemCode])
  @@index([transactionType])
  @@index([timestamp])
  @@index([itemCode, timestamp])
  @@map("stock_ledger")
}

model Outward {
  id             String   @id @default(cuid())
  indentId       String?  @map("indent_id")
  sourceId       String   @map("source_id")
  sourceType     String   @map("source_type")
  rmCode         String   @map("rm_code")
  qtyIssued      Float    @map("qty_issued")
  operationalQty Float?   @map("operational_qty")
  operationalUom String?  @map("operational_uom")
  remarks        String?
  timestamp      DateTime @default(now())
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")
  createdBy      String?  @map("created_by") @db.VarChar(255)
  updatedBy      String?  @map("updated_by") @db.VarChar(255)

  @@index([sourceId])
  @@index([rmCode])
  @@index([timestamp])
  @@map("outward")
}

model BomIssueSession {
  id          String   @id
  planTaskId  String?  @map("plan_task_id")
  productCode String?  @map("product_code")
  productName String   @map("product_name")
  batchQty    Float    @map("batch_qty")
  batchUom    String   @default("kg") @map("batch_uom")
  batchRef    String?  @map("batch_ref")
  diNo        String?  @map("di_no")
  bomLines    Json     @map("bom_lines")
  startedAt   DateTime @default(now()) @map("started_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")
  createdAt   DateTime @default(now()) @map("created_at")
  createdBy   String?  @map("created_by") @db.VarChar(255)
  updatedBy   String?  @map("updated_by") @db.VarChar(255)

  @@map("bom_issue_session")
}
