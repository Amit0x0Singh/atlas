model RmMaster {
  itemCode           String   @id @map("item_code")
  itemName           String   @unique @map("item_name")
  inventoryUom       String   @map("inventory_uom")
  operationalUom     String?  @map("operational_uom")
  trackingType       String   @default("PACK") @map("tracking_type")
  category           String?  @map("category")
  subCategory        String?  @map("sub_category")
  state              String?  @map("physical_state")
  // Generic Inventory-UOM-per-one-Operation-UOM factor (NOT specifically
  // density): KG per L for a liquid issued in L, KG per pouch for a packing
  // item issued in NOS, etc. DB column kept as "density" so no data migration
  // is needed — existing liquid values (kg/L) are already exactly this factor.
  conversionFactor   Float?   @map("density")
  conversionRequired Boolean  @default(false) @map("conversion_required")
  lowStockLevel      Float?   @map("low_stock_level")
  highStockLevel     Float?   @map("high_stock_level")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at")
  createdBy          String?  @map("created_by") @db.VarChar(255)
  updatedBy          String?  @map("updated_by") @db.VarChar(255)

  @@map("rm_master")
}

model LotSequence {
  itemCode String @map("item_code")
  year     Int
  seq      Int    @default(0)

  @@id([itemCode, year])
  @@map("lot_sequence")
}

model PrintMaster {
  id           String   @id @default(cuid())
  gateInwardId String   @map("gate_inward_id") @db.Uuid
  itemCode     String   @map("item_code")
  itemName     String   @map("item_name")
  lotNo        String   @map("lot_no")
  packQty      Float    @map("pack_qty")
  numberOfBags Int      @map("number_of_bags")
  uom          String
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")
  createdBy    String?  @map("created_by") @db.VarChar(255)
  updatedBy    String?  @map("updated_by") @db.VarChar(255)

  gateInward GateInward   @relation(fields: [gateInwardId], references: [inwardId])
  bags       PackDetail[]

  @@unique([itemCode, lotNo])
  @@index([gateInwardId])
  @@map("print_master")
}

model PackDetail {
  packId            String    @id @map("pack_id")
  printMasterId     String    @map("print_master_id")
  itemCode          String    @map("item_code")
  bagNo             Int       @map("bag_no")
  totalQty          Float     @map("total_qty")
  remainingQty      Float     @map("remaining_qty")
  status            String    @default("AWAITING_INWARD")
  warehouse         String?
  customerBatchCode String?   @map("customer_batch_code")
  expiryDate        DateTime? @map("expiry_date")
  scannedAt         DateTime? @map("scanned_at")
  inwardedAt        DateTime? @map("inwarded_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at")
  createdBy         String?   @map("created_by") @db.VarChar(255)
  updatedBy         String?   @map("updated_by") @db.VarChar(255)

  printMaster PrintMaster @relation(fields: [printMasterId], references: [id])

  @@unique([printMasterId, bagNo])
  @@index([itemCode])
  @@index([status])
  @@index([warehouse])
  @@map("pack_detail")
}

model ContainerMaster {
  containerId String   @id @map("container_id")
  itemCode    String   @unique @map("item_code")
  itemName    String   @map("item_name")
  capacity    Float
  currentQty  Float    @default(0) @map("current_qty")
  uom         String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")
  createdBy   String?  @map("created_by") @db.VarChar(255)
  updatedBy   String?  @map("updated_by") @db.VarChar(255)

  @@map("container_master")
}

model StockLedger {
  id              String   @id @default(cuid())
  itemCode        String   @map("item_code")
  sourceId        String   @map("source_id")
  transactionType String   @map("transaction_type")
  inQty           Float    @default(0) @map("in_qty")
  outQty          Float    @default(0) @map("out_qty")
  balance         Float
  reference       String?
  timestamp       DateTime @default(now())
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")
  createdBy       String?  @map("created_by") @db.VarChar(255)
  updatedBy       String?  @map("updated_by") @db.VarChar(255)

  @@index([itemCode])
  @@index([transactionType])
  @@index([timestamp])
  @@index([itemCode, timestamp])
  @@map("stock_ledger")
}

model Outward {
  id             String   @id @default(cuid())
  indentId       String?  @map("indent_id")
  sourceId       String   @map("source_id")
  sourceType     String   @map("source_type")
  rmCode         String   @map("rm_code")
  qtyIssued      Float    @map("qty_issued")
  operationalQty Float?   @map("operational_qty")
  operationalUom String?  @map("operational_uom")
  remarks        String?
  timestamp      DateTime @default(now())
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")
  createdBy      String?  @map("created_by") @db.VarChar(255)
  updatedBy      String?  @map("updated_by") @db.VarChar(255)

  @@index([sourceId])
  @@index([rmCode])
  @@index([timestamp])
  @@map("outward")
}

// ─── Material Indent ──────────────────────────────────────────────────────────
// Plant sections raise a Material Indent for general/daily-use store items
// (PPE, cleaning consumables, IPA, hand wash, …) — items that live in RM
// Master but aren't BOM raw materials. Submitting moves no stock; the Store
// issues each line later via QR scan (see the Open Indents workflow under
// Store Outward), which is what actually deducts inventory.
model MaterialIndent {
  id              String    @id @default(cuid())
  // Null while DRAFT; assigned on submit as "{DEPT}-MR-{YY}-{0001}".
  indentNo        String?   @unique @map("indent_no")
  year            Int
  departmentCode  String    @map("department_code")
  departmentName  String    @map("department_name")
  // Legacy from the prototype — no longer collected on the form (kept
  // nullable so old rows and any future use still validate).
  purpose         String?
  otherPurpose    String?   @map("other_purpose")
  priority        String    @default("Normal")
  criticalReason  String?   @map("critical_reason")
  overallRemarks  String?   @map("overall_remarks")
  // DRAFT | OPEN | PARTIAL | COMPLETED | REJECTED | CANCELLED
  status          String    @default("DRAFT")
  rejectionReason String?   @map("rejection_reason")
  submittedAt     DateTime? @map("submitted_at")
  completedAt     DateTime? @map("completed_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")
  // createdBy holds the requester's email (auto-stamped) — "My Indents" filters on it.
  createdBy       String?   @map("created_by") @db.VarChar(255)
  updatedBy       String?   @map("updated_by") @db.VarChar(255)
  // Snapshot of the requester taken at submit time from their account:
  //  • requesterName   — full name, shown ("Amit Nano") instead of the raw email
  //  • requesterPlants — their User.plants[]; drives plant-scoped visibility on
  //    the requester listing (a Nano person sees only Nano-plant indents, etc.)
  requesterName   String?   @map("requester_name")
  requesterPlants String[]  @default([]) @map("requester_plants")

  items MaterialIndentItem[]

  @@index([status])
  @@index([departmentCode])
  @@index([createdBy])
  @@index([submittedAt])
  @@map("material_indent")
}

model MaterialIndentItem {
  id                  String   @id @default(cuid())
  indentId            String   @map("indent_id")
  itemCode            String   @map("item_code")
  itemName            String   @map("item_name")
  category            String?
  subCategory         String?  @map("sub_category")
  uom                 String
  requestedQty        Float    @map("requested_qty")
  issuedQty           Float    @default(0) @map("issued_qty")
  // PENDING | PARTIAL | ISSUED | REJECTED
  lineStatus          String   @default("PENDING") @map("line_status")
  lineRejectionReason String?  @map("line_rejection_reason")
  remarks             String?
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at")
  createdBy           String?  @map("created_by") @db.VarChar(255)
  updatedBy           String?  @map("updated_by") @db.VarChar(255)

  indent MaterialIndent @relation(fields: [indentId], references: [id], onDelete: Cascade)

  @@index([indentId])
  @@map("material_indent_item")
}

model MaterialIndentSequence {
  departmentCode String @map("department_code")
  year           Int
  seq            Int    @default(0)

  @@id([departmentCode, year])
  @@map("material_indent_sequence")
}

model BomIssueSession {
  id          String   @id
  planTaskId  String?  @map("plan_task_id")
  productCode String?  @map("product_code")
  productName String   @map("product_name")
  batchQty    Float    @map("batch_qty")
  batchUom    String   @default("kg") @map("batch_uom")
  batchRef    String?  @map("batch_ref")
  diNo        String?  @map("di_no")
  bomLines    Json     @map("bom_lines")
  startedAt   DateTime @default(now()) @map("started_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")
  createdAt   DateTime @default(now()) @map("created_at")
  createdBy   String?  @map("created_by") @db.VarChar(255)
  updatedBy   String?  @map("updated_by") @db.VarChar(255)

  @@map("bom_issue_session")
}
