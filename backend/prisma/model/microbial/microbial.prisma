model MicrobialStrain {
  strainId          String   @id @default(dbgenerated("gen_random_uuid()")) @map("strain_id") @db.Uuid
  strainName        String   @map("strain_name") @db.VarChar(200)
  decayK            Decimal  @default(0.01) @map("decay_k") @db.Decimal(10, 6)
  optimalTempC      Decimal? @map("optimal_temp_c") @db.Decimal(5, 2)
  minViableCfuPerMl Decimal? @map("min_viable_cfu_per_ml") @db.Decimal(15, 2)
  notes             String?
  isActive          Boolean  @default(true) @map("is_active")
  createdBy         String?  @map("created_by")
  updatedBy         String?  @map("updated_by")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  containers MicrobialContainer[]

  @@map("microbial_strains")
}

model MicrobialContainer {
  containerId      String   @id @default(dbgenerated("gen_random_uuid()")) @map("container_id") @db.Uuid
  strainId         String   @map("strain_id") @db.Uuid
  locationRoom     String?  @map("location_room") @db.VarChar(200)
  locationPosition String?  @map("location_position") @db.VarChar(100)
  volumeLitres     Decimal  @map("volume_litres") @db.Decimal(10, 3)
  mfgCfuPerMl      Decimal  @map("mfg_cfu_per_ml") @db.Decimal(15, 2)
  mfgDate          DateTime @map("mfg_date") @db.Date
  expiryDate       DateTime @map("expiry_date") @db.Date
  storageTempC     Decimal? @map("storage_temp_c") @db.Decimal(5, 2)
  status           String   @default("healthy") @db.VarChar(20)
  notes            String?
  createdBy        String?  @map("created_by")
  updatedBy        String?  @map("updated_by")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  strain       MicrobialStrain        @relation(fields: [strainId], references: [strainId])
  transactions MicrobialTransaction[]

  @@map("microbial_containers")
}

model MicrobialTransaction {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @map("id") @db.Uuid
  containerId        String    @map("container_id") @db.Uuid
  jobId              String?   @map("job_id") @db.Uuid
  volumeDispatchedL  Decimal   @map("volume_dispatched_l") @db.Decimal(10, 3)
  cfuPerMlAtDispatch Decimal?  @map("cfu_per_ml_at_dispatch") @db.Decimal(15, 2)
  dispatchTempC      Decimal?  @map("dispatch_temp_c") @db.Decimal(5, 2)
  dispatchedBy       String?   @map("dispatched_by") @db.Uuid
  receiverName       String?   @map("receiver_name") @db.VarChar(200)
  dispatchDate       DateTime  @default(now()) @map("dispatch_date") @db.Timestamptz()
  receiptConfirmed   Boolean   @default(false) @map("receipt_confirmed")
  receiptConfirmedAt DateTime? @map("receipt_confirmed_at") @db.Timestamptz()
  receiptNotes       String?   @map("receipt_notes")
  actualCfuOnReceipt Decimal?  @map("actual_cfu_on_receipt") @db.Decimal(15, 2)

  container MicrobialContainer @relation(fields: [containerId], references: [containerId])

  @@map("microbial_transactions")
}

model MicrobeMaster {
  microbeId   String   @id @default(dbgenerated("gen_random_uuid()::text")) @map("microbe_id")
  microbeName String   @map("microbe_name")
  microbeCode String   @unique @map("microbe_code")
  uom         String?  @map("uom")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  createdBy   String?  @map("created_by") @db.VarChar(255)
  updatedBy   String?  @map("updated_by") @db.VarChar(255)

  containers MicrobialSfgContainer[]
  inwards    MicrobialSfgInward[]

  @@map("microbe_master")
}

model MicrobialSfgContainerSeq {
  microbeCode String @map("microbe_code")
  typeCode    String @map("type_code")
  seq         Int    @default(0)

  @@id([microbeCode, typeCode])
  @@map("microbial_sfg_container_seq")
}

model MicrobialSfgContainer {
  containerId      String   @id @default(dbgenerated("gen_random_uuid()::text")) @map("container_id")
  containerCode    String   @unique @map("container_code")
  microbeId        String?  @map("microbe_id")
  microbeCode      String   @map("microbe_code")
  microbeName      String   @map("microbe_name")
  microbeType      String   @map("microbe_type")
  typeCode         String   @map("type_code")
  seqNo            Int      @default(1) @map("seq_no")
  location         String?
  rack             Int?
  shelf            Int?
  side             String?
  position         String?
  capacityKg       Float?   @map("capacity_kg")
  currentQtyKg     Float    @default(0) @map("current_qty_kg")
  fillStatus       String   @default("EMPTY") @map("fill_status")
  inactive         Boolean  @default(false)
  inactiveLocation String?  @map("inactive_location")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  createdBy        String?  @map("created_by") @db.VarChar(255)
  updatedBy        String?  @map("updated_by") @db.VarChar(255)

  microbe MicrobeMaster?       @relation(fields: [microbeId], references: [microbeId])
  inwards MicrobialSfgInward[]

  @@map("microbial_sfg_container")
}

model MicrobialSfgInward {
  inwardId         String   @id @default(dbgenerated("gen_random_uuid()::text")) @map("inward_id")
  containerId      String?  @map("container_id")
  containerCode    String   @map("container_code")
  microbeId        String?  @map("microbe_id")
  microbeCode      String   @map("microbe_code")
  microbeName      String   @map("microbe_name")
  microbeType      String   @map("microbe_type")
  inhouseCfuPerG   Float    @map("inhouse_cfu_per_g")
  biomassBatchCode String   @map("biomass_batch_code")
  dateOfHarvest    DateTime @map("date_of_harvest") @db.Date
  totalQtyKg       Float    @map("total_qty_kg")
  remainingQtyKg   Float    @map("remaining_qty_kg")
  location         String?
  moisture         Float?
  shelfLifeDays    Int?     @map("shelf_life_days")
  pouchNos         Int?     @map("pouch_nos")
  pouchQty         Float?   @map("pouch_qty")
  receivedBy       String?  @map("received_by")
  remarks          String?
  fillStatus       String   @default("PARTIAL") @map("fill_status")
  status           String   @default("ACTIVE")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  createdBy        String?  @map("created_by") @db.VarChar(255)
  updatedBy        String?  @map("updated_by") @db.VarChar(255)

  container    MicrobialSfgContainer?    @relation(fields: [containerId], references: [containerId])
  microbe      MicrobeMaster?            @relation(fields: [microbeId], references: [microbeId])
  allocations  MicrobialSfgAllocation[]
  outwardLines MicrobialSfgOutwardLine[]
  adjustments  MicrobialSfgAdjustment[]

  @@map("microbial_sfg_inward")
}

model MicrobialSfgAllocation {
  allocationId         String    @id @default(dbgenerated("gen_random_uuid()::text")) @map("allocation_id")
  planId               String    @map("plan_id")
  inwardId             String?   @map("inward_id")
  containerCode        String    @map("container_code")
  microbeCode          String    @map("microbe_code")
  microbeName          String    @map("microbe_name")
  microbeType          String    @map("microbe_type")
  allocatedQtyKg       Float     @map("allocated_qty_kg")
  multiplicationFactor Float     @default(1) @map("multiplication_factor")
  requiredCfuPerG      Float?    @map("required_cfu_per_g")
  inhouseCfuPerG       Float?    @map("inhouse_cfu_per_g")
  orderQtyKg           Float?    @map("order_qty_kg")
  status               String    @default("RESERVED")
  notifiedAt           DateTime? @map("notified_at") @db.Timestamptz()
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt            DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  createdBy            String?   @map("created_by") @db.VarChar(255)
  updatedBy            String?   @map("updated_by") @db.VarChar(255)

  inward MicrobialSfgInward? @relation(fields: [inwardId], references: [inwardId])

  @@map("microbial_sfg_allocation")
}

model MicrobialSfgOutward {
  outwardId    String   @id @default(dbgenerated("gen_random_uuid()::text")) @map("outward_id")
  productName  String   @map("product_name")
  customerName String?  @map("customer_name")
  diNumber     String?  @map("di_number")
  batchCode    String?  @map("batch_code")
  section      String?  @map("section")
  orderQtyKg   Float?   @map("order_qty_kg")
  issuerName   String?  @map("issuer_name")
  receiverName String?  @map("receiver_name")
  issuedAt     DateTime @default(now()) @map("issued_at") @db.Timestamptz()
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  createdBy    String?  @map("created_by") @db.VarChar(255)
  updatedBy    String?  @map("updated_by") @db.VarChar(255)

  lines MicrobialSfgOutwardLine[]

  @@map("microbial_sfg_outward")
}

model MicrobialSfgOutwardLine {
  lineId          String   @id @default(dbgenerated("gen_random_uuid()::text")) @map("line_id")
  outwardId       String   @map("outward_id")
  microbeId       String?  @map("microbe_id")
  microbeCode     String   @map("microbe_code")
  microbeName     String   @map("microbe_name")
  microbeType     String   @map("microbe_type")
  requiredQtyKg   Float    @map("required_qty_kg")
  requiredCfuPerG Float    @map("required_cfu_per_g")
  inwardId        String   @map("inward_id")
  containerId     String   @map("container_id")
  containerCode   String   @map("container_code")
  qtyIssuedKg     Float    @map("qty_issued_kg")
  cfuPerGAtIssue  Float    @map("cfu_per_g_at_issue")
  balanceAfterKg  Float    @map("balance_after_kg")
  isPartial       Boolean  @default(false) @map("is_partial")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  createdBy       String?  @map("created_by") @db.VarChar(255)
  updatedBy       String?  @map("updated_by") @db.VarChar(255)

  outward MicrobialSfgOutward @relation(fields: [outwardId], references: [outwardId], onDelete: Cascade)
  inward  MicrobialSfgInward  @relation(fields: [inwardId], references: [inwardId])

  @@map("microbial_sfg_outward_line")
}

model MicrobialSfgOutwardSession {
  id         String   @id
  planTaskId String?  @map("plan_task_id")
  header     Json
  rows       Json
  startedAt  DateTime @default(now()) @map("started_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")
  createdAt  DateTime @default(now()) @map("created_at")
  createdBy  String?  @map("created_by") @db.VarChar(255)
  updatedBy  String?  @map("updated_by") @db.VarChar(255)

  @@map("microbial_sfg_outward_session")
}

// A booked stock loss against one inward batch — biomass lost during
// issuance, release to production, or transport between storage locations.
// Deduction-only (never a gain): lossQtyKg is always the positive magnitude
// removed from the batch, mirrored onto the batch's container in the same
// transaction. Surfaced in Transaction History as an ADJUSTMENT row with a
// negative qty, alongside INWARD and OUTWARD.
model MicrobialSfgAdjustment {
  adjustmentId    String   @id @default(dbgenerated("gen_random_uuid()::text")) @map("adjustment_id")
  inwardId        String   @map("inward_id")
  containerId     String?  @map("container_id")
  containerCode   String   @map("container_code")
  microbeId       String?  @map("microbe_id")
  microbeCode     String   @map("microbe_code")
  microbeName     String   @map("microbe_name")
  microbeType     String   @map("microbe_type")
  lossQtyKg       Float    @map("loss_qty_kg")
  cfuPerGAtAdjust Float?   @map("cfu_per_g_at_adjust")
  balanceBeforeKg Float    @map("balance_before_kg")
  balanceAfterKg  Float    @map("balance_after_kg")
  reasonCategory  String   @map("reason_category")
  reason          String
  stage           String?
  adjustedBy      String   @map("adjusted_by")
  remarks         String?
  batchCode       String?  @map("batch_code")
  adjustedAt      DateTime @default(now()) @map("adjusted_at") @db.Timestamptz()
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  createdBy       String?  @map("created_by") @db.VarChar(255)
  updatedBy       String?  @map("updated_by") @db.VarChar(255)

  inward MicrobialSfgInward @relation(fields: [inwardId], references: [inwardId])

  @@index([inwardId])
  @@index([microbeCode])
  @@index([adjustedAt])
  @@map("microbial_sfg_adjustment")
}
