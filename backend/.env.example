# Postgres connection string
DATABASE_URL=postgresql://user:password@localhost:5432/som_erp

PORT=3001

# "production" in any real deployment — several security guards (the
# BYPASS_AUTH dev-auth-skip below, the CORS whitelist branch in server.js)
# key off this being exactly "production"; leaving it unset behaves like dev.
NODE_ENV=development

# HMAC signing secret for auth JWTs — required, no fallback. Generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Rotating this value invalidates every currently-issued token (forces
# re-login everywhere) — both frontends already handle this automatically
# via their existing 401 interceptors.
JWT_SECRET=

# Dev-only convenience — skips authentication entirely and injects a
# hardcoded super-admin user. Ignored unless NODE_ENV !== production, but
# never set this to true anywhere near a real deployment.
BYPASS_AUTH=false

# Comma-separated list of allowed frontend origins, checked in production
# mode only (dev mode allows any http://localhost:<port> automatically).
# This app has two frontends — main ERP and the admin panel.
FRONTEND_URLS=https://erp.example.com,https://admin.example.com
